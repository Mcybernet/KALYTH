# Copy to your shell environment. Never commit a filled-in copy.
#
# Devnet RPC endpoint. The public endpoint is heavily rate limited.
DEVNET_RPC_URL=https://api.devnet.solana.com

# One-time migration (scripts/migrate-burn.mjs)
# Path to a Solana keypair JSON file, an inline JSON array, or a base58 secret.
BURN_STATE_AUTHORITY_KEYPAIR=/absolute/path/to/curve-authority.json
BURN_RESERVE_OWNER_KEYPAIR=/absolute/path/to/burn-reserve-owner.json

# Daily crank (scripts/burn-daily.mjs). Fund this wallet with Devnet SOL only.
BURN_CRANK_KEYPAIR=/absolute/path/to/burn-crank.json

# Optional: override the daily cap. Raw units, 6 decimals.
# 800,000 KLYTH = 800000000000
# DAILY_BURN_CAP_RAW=800000000000

# Demo trader (scripts/demo-trade.mjs). Devnet only. Use a dedicated wallet and
# fund it with Devnet SOL. Never reuse the burn crank, treasury, or curve keys.
DEMO_TRADE_KEYPAIR=/absolute/path/to/demo-trade.json

# Master switch for the demo trader. Set to 0 to stop it without deleting keys.
# DEMO_TRADING_ENABLED=1

# Optional tuning (defaults shown).
# DRY_RUN=0
# DEMO_TRADES_PER_RUN=1
# DEMO_MIN_TRADE_SOL=0.002
# DEMO_MAX_TRADE_SOL=0.02
# DEMO_MIN_SOL_BUFFER=0.005
# DEMO_MAX_VAULT_BPS=50
# DEMO_MAX_RESERVE_BPS=50
# DEMO_MAX_SELL_WALLET_BPS=2500
# DEMO_SELL_PROBABILITY=0.45
# DEMO_SLIPPAGE_BPS=100
# DEMO_MAX_DELAY_MS=30000
